@page
@model HistoryModel
@{ ViewData["Title"] = "Histórico"; }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Histórico de looks</h1>
    <a asp-page-handler="Csv" class="btn btn-outline-secondary btn-sm"><partial name="_Icon" model="@("download")" /> Exportar CSV</a>
</div>

@if (Model.Outfits.Count == 0)
{
    <div class="card empty-state">
        <div class="empty-ico"><partial name="_Icon" model="@("clock")" /></div>
        <h2 class="h5">Nenhum look registrado ainda</h2>
        <p class="text-muted">Na tela Look do dia, clique em “Vou usar este” e o look aparece aqui.</p>
        <div><a asp-page="/Index" class="btn btn-accent"><partial name="_Icon" model="@("sparkle")" /> Ver o look do dia</a></div>
    </div>
}

@foreach (var o in Model.Outfits)
{
    var date = o.WornOn.ToString("ddd, dd/MM/yyyy");
    <article class="card p-3 mb-3" aria-label="Look de @date">
        <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
            <div>
                <h2 class="h6 mb-0">@date</h2>
                @if (!string.IsNullOrEmpty(o.Title)) { <div class="small">@o.Title</div> }
                <div class="history-meta">
                    <span class="chip">@o.Occasion.DisplayName()</span>
                    @if (o.TemperatureC.HasValue) { <span class="chip"><partial name="_Icon" model="@("thermo")" /> @o.TemperatureC.Value.ToString("0")°C @o.WeatherDescription</span> }
                </div>
            </div>
            <div class="d-flex gap-1 align-items-center">
                <div class="stars" role="group" aria-label="Nota do look (@(o.Rating ?? 0) de 5)">
                    @for (var star = 1; star <= 5; star++)
                    {
                        var on = o.Rating >= star;
                        <form method="post" asp-page-handler="Rate" class="d-inline">
                            <input type="hidden" name="id" value="@o.Id" /><input type="hidden" name="rating" value="@star" />
                            <button class="star-btn @(on ? "" : "is-off")" title="Nota @star" aria-label="Dar nota @star de 5" aria-pressed="@(o.Rating == star ? "true" : "false")"><span aria-hidden="true">@(on ? "★" : "☆")</span></button>
                        </form>
                    }
                </div>
                <form method="post" asp-page-handler="Delete" class="d-inline ms-2">
                    <input type="hidden" name="id" value="@o.Id" />
                    <button class="btn btn-sm btn-outline-danger btn-icon" aria-label="Apagar o registro de @date" title="Apagar registro" onclick="return confirm('Apagar este registro?')"><partial name="_Icon" model="@("trash")" /></button>
                </form>
            </div>
        </div>
        <div class="look-items">
            @foreach (var i in o.Items.Select(x => x.ClothingItem))
            {
                <div class="look-item"><partial name="_ItemThumb" model="i" /><div class="mt-1">@i.Name</div></div>
            }
        </div>
    </article>
}
