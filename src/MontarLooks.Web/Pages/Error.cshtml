@page
@model ErrorModel
@{ ViewData["Title"] = "Erro"; }
<h1 class="h3">Ops, algo deu errado.</h1>
<p class="text-muted">Tente novamente. Se continuar, veja os logs do container com <code>docker compose logs web</code>.</p>
@if (Model.ShowRequestId)
{
    <p><small>Código da solicitação: <code>@Model.RequestId</code></small></p>
}
