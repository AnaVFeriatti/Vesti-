@page
@using MontarLooks.Web.Services
@model MontarLooks.Web.Pages.Wardrobe.BulkModel
@{
    var batch = Model.Batch;
    var retouch = batch?.Kind == PhotoBatchKind.Reprocess;
    ViewData["Title"] = batch is null ? "Enviar fotos" : retouch ? "Retocando fotos" : "Preparando fotos";
}

<link rel="stylesheet" href="~/css/photo-tools.css" asp-append-version="true" />

<a asp-page="Index" class="small text-muted">← Meu Closet</a>

@if (batch is not null)
{
    <h1 class="h3 my-3">@ViewData["Title"]</h1>
    <div class="row">
        <div class="col-lg-7">
            <div class="card p-4 batch" data-photo-batch data-status-url="@Url.Page("Bulk", "Status", new { id = batch.Id })"
                 data-finished="@(batch.Finished ? "true" : "false")">
                <p class="text-muted">
                    Pode continuar usando o Vestiê enquanto eu cuido das fotos. Se voltar a esta página, o progresso continua aqui.
                </p>
                <div class="batch-bar" role="progressbar" aria-label="Progresso das fotos" aria-valuemin="0" aria-valuemax="100"
                     aria-valuenow="@batch.Percent" data-batch-bar>
                    <span style="width: @(batch.Percent)%" data-batch-fill></span>
                </div>
                <p class="batch-count" data-batch-count>@batch.Processed de @batch.Total foto(s)</p>
                <p class="batch-status" role="status" aria-live="polite" data-batch-status>@(batch.Message ?? "Na fila, já começo...")</p>
                <a class="btn btn-accent align-self-start" href="@batch.NextUrl" data-batch-next hidden="@(batch.NextUrl is null)"
                   data-review-label="Completar os detalhes">@(retouch ? "Ver Meu Closet" : "Continuar")</a>
                <noscript><a asp-page="Bulk" asp-route-job="@batch.Id">Atualizar o progresso</a></noscript>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="~/js/photo-batch.js" asp-append-version="true"></script>
    }
}
else
{
    <h1 class="h3 my-3">Enviar várias fotos</h1>
    <div class="row">
        <div class="col-lg-7">
            <form method="post" enctype="multipart/form-data" class="card p-4">
                @if (Model.BatchMissing)
                {
                    <p class="text-danger">Não encontrei esse lote. O app pode ter reiniciado; confira no Meu Closet o que já foi salvo.</p>
                }
                <div asp-validation-summary="All" class="text-danger"></div>
                <p class="text-muted">
                    Tire uma foto de cada peça (de preferência esticada num fundo liso) e envie todas de uma vez.
                    Cada foto vira uma peça, e em seguida eu te levo peça por peça para preencher cor, estilo, calor e formalidade.
                </p>
                <div class="mb-3">
                    <label class="form-label" for="photos">Fotos</label>
                    <input id="photos" type="file" name="Photos" accept="image/*" multiple class="form-control" required />
                </div>
                <div class="mb-4">
                    <label class="form-label" asp-for="Category">Categoria inicial (dá pra mudar depois)</label>
                    <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<Category>()"></select>
                    <div class="form-text">Dica: envie em lotes por categoria, por exemplo todas as calças juntas.</div>
                </div>
                <button class="btn btn-accent">Enviar</button>
            </form>
        </div>
    </div>
}
